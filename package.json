{
  "name": "nike-pulse",
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "seed": "node --import tsx scripts/seed.ts",
    "format": "prettier --write app components lib scripts tests *.ts *.mjs *.json README.md",
    "test:production": "node --import tsx scripts/verify-production.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "description": "Independent Nike brand perception research",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.0",
    "framer-motion": "^13.4.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
